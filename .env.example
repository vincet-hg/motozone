# Copy to .env.local for your computer. In Vercel, set the same names under
# Settings > Environment Variables, with different values for Preview (staging) and Production.
# Leave NEXT_PUBLIC_SUPABASE_URL empty locally to run in demo mode.

# Supabase > Project Settings > API Keys (older projects: the legacy anon and service_role keys work too)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: never add NEXT_PUBLIC_ to it and never share it. It bypasses all access rules.
SUPABASE_SECRET_KEY=sb_secret_...

# Production only: the store's address, without a trailing slash. Used for canonical links and the sitemap.
# Vercel previews use their own address automatically and are never indexed.
NEXT_PUBLIC_SITE_URL=https://scooterland.ge
# Optional: set to false on a test deployment outside Vercel so Google does not index it.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Optional: new-order messages in Telegram. See README > Order notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Search Console > Ownership verification > HTML tag, the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional, demo mode only: your own local admin login.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
