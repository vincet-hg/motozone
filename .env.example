# Copy to .env.local for your computer. In Vercel, set the same names under
# Settings > Environment Variables, with different values for Preview (staging) and Production.
# Leave NEXT_PUBLIC_SUPABASE_URL empty locally to run in demo mode.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service_role key. Server only: never add NEXT_PUBLIC_ to it and never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full address of this deployment, without a trailing slash. Used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://scooterland.ge
# Set to false on staging and previews so Google does not index them.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Optional: new-order messages in Telegram. See README > Order notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Google Search Console > Ownership verification > HTML tag, the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Optional, demo mode only: your own local admin login.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
